# Copy to .env (never commit .env)
DATABASE_URL=postgresql://orderpal:orderpal@localhost:5433/orderpal
REDIS_URL=redis://localhost:6380/0

# Phase 2: local embedding model (free, runs on your laptop, 384 dims)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Phase 4: LLM. Get a key from aistudio.google.com -> Get API key, and paste it into .env yourself.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Phase 9: cost tracking (fill in from the provider's pricing page) and rate limiting
LLM_PRICE_INPUT_USD_PER_M=0
LLM_PRICE_OUTPUT_USD_PER_M=0
USD_TO_INR=0
RATE_LIMIT_PER_MINUTE=10
